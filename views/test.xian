{{> header}}

<h1>{{title}}</h1>
<p>{{content}}</p>

<table border="1">
  <thead>
    <tr>
      <th>Name</th>
      <th>Age</th>
      <th>Address</th>
    </tr>
  </thead>
  <tbody>
    {{#each data}}
    <tr>
      <td>{{name}}</td>
      <td>{{age}}</td>
      <td>{{address}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{> footer}}