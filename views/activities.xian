{{> header}}
<body class="bg-gray-50">
  <div class="container mx-auto px-4 py-8 max-w-2xl">
    <h1 class="text-3xl font-bold mb-2">Class Activities</h1>
    <p class="text-gray-600 mb-6">Jean Raven Magaling — click a link to open each activity.</p>

    {{#each activities}}
    <div class="bg-white rounded-lg shadow p-4 mb-4">
      <h2 class="text-lg font-semibold text-gray-800">Activity {{number}}: {{name}}</h2>
      <p class="text-sm text-gray-500 mb-2">Date done: {{date}}</p>
      {{#each links}}
      <a href="{{this}}" class="inline-block mr-4 text-blue-600 hover:underline">{{this}}</a>
      {{else}}
      <span class="text-sm text-gray-400">No link yet</span>
      {{/each}}
    </div>
    {{/each}}
  </div>
{{> footer}}
