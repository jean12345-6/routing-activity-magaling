<!DOCTYPE html>
<html>
<head>
  <title>Book List</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    table { border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid #333; padding: 8px 12px; }
    th { background: #eee; }
  </style>
</head>
<body>
  <h1>Book List</h1>
  <a href="/library/create">+ Add Book</a>

  <table>
    <tr>
      <th>ID</th>
      <th>Title</th>
      <th>Author</th>
      <th>Genre</th>
      <th>Year</th>
      <th>Price</th>
    </tr>
    {{#each books}}
    <tr>
      <td>{{id}}</td>
      <td>{{title}}</td>
      <td>{{author}}</td>
      <td>{{genre}}</td>
      <td>{{year}}</td>
      <td>{{price}}</td>
    </tr>
    {{else}}
    <tr><td colspan="6">No books yet.</td></tr>
    {{/each}}
  </table>
</body>
</html>