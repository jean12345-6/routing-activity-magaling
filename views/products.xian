{{> header}}
<body class="bg-gray-100">

  {{> sidebar}}
  {{> topbar}}
  {{> breadcrumbs}}

  <main class="ml-64 mt-8 p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-4">Products</h1>

    <table class="w-full bg-white rounded-lg shadow overflow-hidden">
      <thead class="bg-gray-800 text-white">
        <tr>
          <th class="text-left px-4 py-2">Name</th>
          <th class="text-left px-4 py-2">Category</th>
          <th class="text-left px-4 py-2">Price</th>
          <th class="text-left px-4 py-2">Stock</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b">
          <td class="px-4 py-2">Cotton T-Shirt</td>
          <td class="px-4 py-2">Apparel</td>
          <td class="px-4 py-2">₱399</td>
          <td class="px-4 py-2">120</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Wireless Earbuds</td>
          <td class="px-4 py-2">Electronics</td>
          <td class="px-4 py-2">₱1,299</td>
          <td class="px-4 py-2">45</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Ceramic Mug</td>
          <td class="px-4 py-2">Home</td>
          <td class="px-4 py-2">₱149</td>
          <td class="px-4 py-2">80</td>
        </tr>
      </tbody>
    </table>
  </main>

  {{> footer}}
