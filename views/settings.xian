{{> header}}
<body class="bg-gray-100">

  {{> sidebar}}
  {{> topbar}}
  {{> breadcrumbs}}

  <main class="ml-64 mt-8 p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-4">Settings</h1>

    <div class="bg-white rounded-lg shadow p-6 max-w-lg">
      <div class="mb-4">
        <label class="block text-gray-600 text-sm mb-1">Full Name</label>
        <input type="text" value="Jean Ramos" class="w-full border rounded px-3 py-2" />
      </div>

      <div class="mb-4">
        <label class="block text-gray-600 text-sm mb-1">Email</label>
        <input type="email" value="jean@example.com" class="w-full border rounded px-3 py-2" />
      </div>

      <button class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-700">
        Save Changes
      </button>
    </div>
  </main>

  {{> footer}}