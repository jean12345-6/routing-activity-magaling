{{> header}}
<body class="bg-gray-100">

  {{> sidebar}}
  {{> topbar}}
  {{> breadcrumbs}}

  <main class="ml-64 mt-8 p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-4">Users</h1>

    <table class="w-full bg-white rounded-lg shadow overflow-hidden">
      <thead class="bg-gray-800 text-white">
        <tr>
          <th class="text-left px-4 py-2">Name</th>
          <th class="text-left px-4 py-2">Email</th>
          <th class="text-left px-4 py-2">Role</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b">
          <td class="px-4 py-2">Jean Ramos</td>
          <td class="px-4 py-2">jean@example.com</td>
          <td class="px-4 py-2">Admin</td>
        </tr>
        <tr class="border-b">
          <td class="px-4 py-2">Juan Dela Cruz</td>
          <td class="px-4 py-2">juan@example.com</td>
          <td class="px-4 py-2">Staff</td>
        </tr>
      </tbody>
    </table>
  </main>

  {{> footer}}