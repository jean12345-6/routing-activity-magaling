<table class="w-full bg-white rounded-lg shadow overflow-hidden mt-6">
  <thead class="bg-gray-800 text-white">
    <tr>
      <th class="text-left px-4 py-2">Product</th>
      <th class="text-left px-4 py-2">Status</th>
      <th class="text-left px-4 py-2">Amount</th>
    </tr>
  </thead>
  <tbody>
    {{#each orders}}
    <tr class="border-b">
      <td class="px-4 py-2">{{product}}</td>
      <td class="px-4 py-2">{{status}}</td>
      <td class="px-4 py-2">{{amount}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>